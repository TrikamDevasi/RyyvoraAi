# Ryyvora AI Frontend Environment Variables
# Copy to .env.local for local development or set in deployment platform (e.g., Vercel)

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Optional Analytics / Monitoring
NEXT_PUBLIC_APP_ENV=development

# ── Billing & Payments Configuration ─────────────────────────────────────────
# Mode: 'demo' (instant simulated checkout for SIH evaluation) | 'razorpay' | 'stripe'
NEXT_PUBLIC_BILLING_MODE=demo
NEXT_PUBLIC_CURRENCY=INR

# Razorpay Client Configuration (Public Test / Live Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Stripe Client Configuration (Public Test / Live Publishable Key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
