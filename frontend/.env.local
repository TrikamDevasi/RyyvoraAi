NEXT_PUBLIC_BILLING_MODE=demo
NEXT_PUBLIC_CURRENCY=INR

# Razorpay Client Configuration (Public Test Key ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_5173demoKey

# Stripe Client Configuration (Public Test Publishable Key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_5173demoKey
